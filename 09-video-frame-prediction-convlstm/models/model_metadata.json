{
  "project_name": "Video Frame Prediction using Convolutional LSTM",
  "project_folder": "09-video-frame-prediction-convlstm",
  "task": "single-step next-frame prediction with optional recursive multi-step inference",
  "input_frames": 6,
  "forecast_horizon": 1,
  "height": 32,
  "width": 32,
  "channels": 1,
  "color_mode": "grayscale",
  "normalization": "pixel values scaled to [0, 1]",
  "dtype": "float32",
  "dataset": {
    "type": "synthetic moving-object sequences",
    "samples": 2500,
    "object": "5x5 white square",
    "motion": "constant velocity with boundary reflection",
    "seed": 42,
    "split": {
      "train": 1750,
      "validation": 375,
      "test": 375
    }
  },
  "model": {
    "framework": "Keras 3",
    "architecture": [
      "ConvLSTM2D(32, 3x3, return_sequences=True)",
      "BatchNormalization",
      "ConvLSTM2D(32, 3x3)",
      "BatchNormalization",
      "Conv2D(16, 3x3, ReLU)",
      "Conv2D(1, 3x3, sigmoid)"
    ],
    "parameters": 117025,
    "loss": "mean_squared_error",
    "optimizer": "Adam",
    "learning_rate": 0.001,
    "training_epochs": 15,
    "batch_size": 32
  },
